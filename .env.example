# Player + admin session signing (required for admin login)
AMOJI_AUTH_SECRET=

# Bootstrap admin account (Admin Control at /admin)
AMOJI_ADMIN_EMAIL=admin@example.com
AMOJI_ADMIN_PASSWORD=
AMOJI_ADMIN_ROLE=superadmin

# Or multiple admins (JSON array; use passwordSha256 from npm run admin:bootstrap)
# AMOJI_ADMIN_ACCOUNTS=[]

# Smart companion chat (Vercel — free tier; see DEPLOY.md)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openrouter/free
# GROQ_API_KEY=gsk_...
