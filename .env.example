# Amoji production / mobile backend
AMOJI_AUTH_SECRET=change-me-long-random-string
AMOJI_APPLE_STRICT=0
APPLE_CLIENT_ID=com.amoji.companion
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REVENUECAT_PUBLIC_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
AMOJI_IAP_DEV=1
AMOJI_USER_STORE_FS=1
AMOJI_MOBILE_SERVER_URL=https://your-domain.vercel.app/app
# Comma-separated origins allowed to call POST /api/iap/* (empty = allow all)
AMOJI_ALLOWED_ORIGINS=
# Stripe web checkout (optional — companion shop Pay with card)
STRIPE_SECRET_KEY=
AMOJI_PUBLIC_URL=https://your-domain.vercel.app
AMOJI_SECURITY_AUDIT=0
