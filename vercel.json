{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "amoji-companion",
  "installCommand": "npm install && cd amoji-engine && npm install && node scripts/download-legal-vrm.mjs",
  "rewrites": [
    { "source": "/api/chat", "destination": "/api/chat" },
    { "source": "/api/search", "destination": "/api/search" },
    { "source": "/api/tts", "destination": "/api/tts" },
    { "source": "/api/stt", "destination": "/api/stt" },
    { "source": "/api/llm/status", "destination": "/api/llm/status" },
    { "source": "/api/ollama/tags", "destination": "/api/llm/ollama-tags" },
    { "source": "/api/health", "destination": "/api/health.mjs" },
    { "source": "/api/motions", "destination": "/api/motions.mjs" },
    { "source": "/prototypes/realtime-voice-lab.html", "destination": "/prototypes/realtime-voice-lab.html" },
    { "source": "/amoji-engine/(.*)", "destination": "/amoji-engine/$1" },
    { "source": "/prototypes/(.*)", "destination": "/prototypes/$1" },
    { "source": "/play", "destination": "/play.html" },
    { "source": "/play/", "destination": "/play.html" },
    { "source": "/go", "destination": "/go.html" },
    { "source": "/go/", "destination": "/go.html" },
    { "source": "/api/play", "destination": "/api/play.mjs" },
    { "source": "/api/auth/guest", "destination": "/api/auth/guest.mjs" },
    { "source": "/api/auth/apple", "destination": "/api/auth/apple.mjs" },
    { "source": "/api/auth/session", "destination": "/api/auth/session.mjs" },
    { "source": "/api/user/save", "destination": "/api/user/save.mjs" },
    { "source": "/api/user/settings", "destination": "/api/user/settings.mjs" },
    { "source": "/api/iap/products", "destination": "/api/iap/products.mjs" },
    { "source": "/api/iap/verify", "destination": "/api/iap/verify.mjs" },
    { "source": "/api/iap/webhook", "destination": "/api/iap/webhook.mjs" },
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/", "destination": "/app/index.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/n/:stamp/full", "destination": "/prototypes/amoji-companion.html" },
    { "source": "/n/:stamp/full/", "destination": "/prototypes/amoji-companion.html" },
    { "source": "/n/:stamp/lite", "destination": "/prototypes/amoji-lite.html" },
    { "source": "/n/:stamp/lite/", "destination": "/prototypes/amoji-lite.html" },
    { "source": "/c/:build/full", "destination": "/prototypes/amoji-companion.html" },
    { "source": "/c/:build/full/", "destination": "/prototypes/amoji-companion.html" },
    { "source": "/c/:build/lite", "destination": "/prototypes/amoji-companion.html" },
    { "source": "/c/:build/lite/", "destination": "/prototypes/amoji-companion.html" },
    { "source": "/setup", "destination": "/prototypes/amoji-setup.html" },
    { "source": "/companion", "destination": "/prototypes/amoji-companion.html" },
    { "source": "/amoji-lite.html", "destination": "/prototypes/amoji-lite.html" },
    { "source": "/companion-full", "destination": "/prototypes/amoji-companion.html" },
    { "source": "/voice-emotion-demo", "destination": "/prototypes/voice-emotion-demo.html" },
    { "source": "/voice-demo", "destination": "/prototypes/voice-emotion-demo.html" },
    { "source": "/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/prototypes/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Clear-Site-Data", "value": "\"cache\"" }
      ]
    },
    {
      "source": "/play",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Clear-Site-Data", "value": "\"cache\"" }
      ]
    },
    {
      "source": "/play/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Clear-Site-Data", "value": "\"cache\"" }
      ]
    },
    {
      "source": "/go",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Clear-Site-Data", "value": "\"cache\"" }
      ]
    },
    {
      "source": "/go/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Clear-Site-Data", "value": "\"cache\"" }
      ]
    },
    {
      "source": "/n/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Clear-Site-Data", "value": "\"cache\"" }
      ]
    },
    {
      "source": "/c/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Clear-Site-Data", "value": "\"cache\"" }
      ]
    },
    {
      "source": "/companion-full",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Clear-Site-Data", "value": "\"cache\"" }
      ]
    },
    {
      "source": "/companion",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Clear-Site-Data", "value": "\"cache\"" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Clear-Site-Data", "value": "\"cache\"" }
      ]
    },
    {
      "source": "/prototypes/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/prototypes/assets/companion-girl.vrm",
      "headers": [
        { "key": "Content-Type", "value": "model/gltf-binary" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/prototypes/assets/kizuna-kamatte.vrm",
      "headers": [
        { "key": "Content-Type", "value": "model/gltf-binary" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=86400, immutable" }
      ]
    },
    {
      "source": "/prototypes/assets/companion-girl.glb",
      "headers": [
        { "key": "Content-Type", "value": "model/gltf-binary" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/prototypes/assets/companion-:name.vrm",
      "headers": [
        { "key": "Content-Type", "value": "model/gltf-binary" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=86400, immutable" }
      ]
    },
    {
      "source": "/prototypes/assets/companion-quinn.glb",
      "headers": [
        { "key": "Content-Type", "value": "model/gltf-binary" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=86400, immutable" }
      ]
    },
    {
      "source": "/api/health",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/amoji-engine/engine/companion/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/amoji-engine/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    }
  ]
}
