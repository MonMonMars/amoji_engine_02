{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "amoji-companion",
  "installCommand": "cd amoji-engine && npm install",
  "rewrites": [
    { "source": "/api/chat", "destination": "/api/chat" },
    { "source": "/api/llm/status", "destination": "/api/llm/status" },
    { "source": "/api/ollama/tags", "destination": "/api/ollama/tags" },
    { "source": "/prototypes/realtime-voice-lab.html", "destination": "/prototypes/realtime-voice-lab.html" },
    { "source": "/amoji-engine/(.*)", "destination": "/amoji-engine/$1" },
    { "source": "/prototypes/(.*)", "destination": "/prototypes/$1" },
    { "source": "/", "destination": "/prototypes/amoji-companion.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/prototypes/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/amoji-engine/(.*\\.(js|mjs|vrm|glb|png|webp|svg))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
