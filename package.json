{
  "name": "amoji-companion-host",
  "private": true,
  "type": "module",
  "description": "Amoji Companion — cloud-hosted 3D chat (Vercel)",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "edge-tts-universal": "^1.4.0",
    "playwright": "^1.63.0"
  },
  "scripts": {
    "verify:local": "node scripts/run-companion-smoke.mjs",
    "verify:mobile": "node scripts/mobile-app-verify.mjs",
    "verify:production": "node scripts/demo-link-verify.mjs",
    "verify:pre-delivery": "node scripts/pre-delivery-verify.mjs",
    "verify:pre-delivery:prod": "PRODUCTION=1 node scripts/pre-delivery-verify.mjs",
    "verify:picker": "node scripts/companion-picker-verify.mjs",
    "verify:scene-shortcuts": "node scripts/scene-shortcuts-demo-verify.mjs",
    "verify:roster-models": "node scripts/verify-roster-models.mjs",
    "verify:admin": "node scripts/admin-console-verify.mjs",
    "verify:debug": "node scripts/companion-diagnose.mjs",
    "verify:production-build": "node scripts/check-production-build.mjs",
    "scene-bg": "node scripts/generate-scene-backgrounds.mjs && node scripts/rasterize-scene-backgrounds.mjs",
    "postinstall": "node amoji-engine/scripts/download-legal-vrm.mjs",
    "inspect:vrm-face": "node scripts/inspect-vrm-face.mjs",
    "smoke:highpoly-face": "node amoji-engine/scripts/highpoly-face-lipsync-smoke.mjs --model kizuna-kamatte.vrm",
    "smoke:kizuna-companion": "node scripts/companion-kizuna-lipsync-smoke.mjs"
  }
}
